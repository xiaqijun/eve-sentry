{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.evesentry.invalid/schemas/events.schema.json",
  "title": "EVE Sentry SSE event payloads",
  "oneOf": [
    {"$ref": "#/$defs/alert"},
    {"$ref": "#/$defs/safe"},
    {"$ref": "#/$defs/monitoring_node"},
    {"$ref": "#/$defs/hostile_movement"}
  ],
  "$defs": {
    "alert": {
      "type": "object",
      "required": ["id", "system_name", "level", "score", "created_at", "source_observation_id", "verified_characters"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "system_name": {"type": "string", "minLength": 1}, "system": {"type": "string"}, "system_id": {"type": ["integer", "null"]}, "names": {"type": "array", "items": {"type": "string"}}, "character_ids": {"type": "array", "items": {"type": "integer", "minimum": 1}}, "active_names": {"type": "array", "items": {"type": "string"}}, "active_character_ids": {"type": "array", "items": {"type": "integer", "minimum": 1}}, "classification": {"type": "string"}, "hostile_count": {"type": "integer", "minimum": 0}, "presence_only": {"type": "boolean"}, "level": {"enum": ["low", "medium", "high", "critical"]}, "score": {"type": "integer"}, "created_at": {"type": "string", "format": "date-time"}, "seen_at": {"type": "string", "format": "date-time"}, "source_observation_id": {"type": "string"}, "verified_characters": {"type": "array", "items": {"type": "object"}}, "evidence": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "safe": {
      "type": "object",
      "required": ["system_name", "hostile_count", "active", "created_at"],
      "properties": {"system_name": {"type": "string", "minLength": 1}, "system": {"type": "string"}, "hostile_count": {"const": 0}, "active": {"const": false}, "created_at": {"type": "string", "format": "date-time"}, "message": {"type": "string"}},
      "additionalProperties": true
    },
    "monitoring_node": {
      "type": "object",
      "required": ["schema_version", "generated_at", "changes", "nodes_version", "nodes"],
      "properties": {"schema_version": {"const": "monitoring_node_event.v1"}, "generated_at": {"type": "string", "format": "date-time"}, "changes": {"type": "array", "items": {"type": "object"}}, "nodes_version": {"type": "string", "minLength": 1}, "nodes": {"type": "array", "items": {"type": "object"}}},
      "additionalProperties": true
    },
    "hostile_movement": {
      "type": "object",
      "required": ["schema_version", "movement_id", "occurred_at", "from_system", "to_system", "hostile_count", "personnel"],
      "properties": {"schema_version": {"const": "hostile_movement_event.v1"}, "movement_id": {"type": "string", "minLength": 1}, "occurred_at": {"type": "string", "format": "date-time"}, "from_system": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}, "system_id": {"type": ["integer", "null"]}}, "additionalProperties": true}, "to_system": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}, "system_id": {"type": ["integer", "null"]}}, "additionalProperties": true}, "hostile_count": {"type": "integer", "minimum": 1}, "personnel": {"type": "array", "items": {"type": "object"}}, "source": {"enum": ["detector", "bootstrap_reconciliation"]}},
      "additionalProperties": true
    }
  }
}
