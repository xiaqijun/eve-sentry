{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.evesentry.invalid/schemas/ocr-query.schema.json",
  "title": "EVE Sentry one-time OCR query protocol",
  "description": "Additive wire contract for requesting a single OCR capture and collecting multi-window results.",
  "oneOf": [
    {"$ref": "#/$defs/query_create"},
    {"$ref": "#/$defs/query_task"},
    {"$ref": "#/$defs/query_result"},
    {"$ref": "#/$defs/heartbeat_response"}
  ],
  "$defs": {
    "query_type": {"type": "string", "enum": ["all", "person", "corporation", "alliance"]},
    "query_status": {"type": "string", "enum": ["pending", "running", "partial", "completed", "failed", "expired"]},
    "node_status": {"type": "string", "enum": ["pending", "captured", "timeout", "ocr_failed", "unavailable"]},
    "ocr_name": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "entity_id": {"type": ["integer", "null"], "minimum": 1},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    },
    "query_create": {
      "type": "object",
      "required": ["request_id", "query_type"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "query_type": {"$ref": "#/$defs/query_type"},
        "target_name": {"type": "string", "minLength": 1},
        "target_id": {"type": ["integer", "null"], "minimum": 1},
        "client_id": {"type": "string", "minLength": 1},
        "source_instance": {"type": "string"},
        "window_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "expires_in_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      },
      "additionalProperties": true
    },
    "query_node": {
      "type": "object",
      "required": ["node_id", "client_id", "window_id", "status"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "client_id": {"type": "string", "minLength": 1},
        "source_instance": {"type": "string"},
        "window_id": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/node_status"},
        "names": {"type": "array", "items": {"$ref": "#/$defs/ocr_name"}},
        "error_code": {"type": "string"},
        "error_message": {"type": "string"},
        "captured_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": true
    },
    "query_task": {
      "type": "object",
      "required": ["request_id", "query_type", "status", "created_at", "expires_at", "nodes"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "query_type": {"$ref": "#/$defs/query_type"},
        "target_name": {"type": "string"},
        "target_id": {"type": ["integer", "null"], "minimum": 1},
        "status": {"$ref": "#/$defs/query_status"},
        "created_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/query_node"}},
        "result": {"$ref": "#/$defs/result_payload"},
        "error_code": {"type": "string"},
        "error_message": {"type": "string"}
      },
      "additionalProperties": true
    },
    "result_payload": {
      "type": "object",
      "required": ["names", "received_nodes", "timed_out_nodes", "failed_nodes"],
      "properties": {
        "names": {"type": "array", "items": {"$ref": "#/$defs/ocr_name"}},
        "received_nodes": {"type": "integer", "minimum": 0},
        "timed_out_nodes": {"type": "integer", "minimum": 0},
        "failed_nodes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "query_result": {
      "type": "object",
      "required": ["request_id", "client_id", "window_id", "query_type", "status", "captured_at", "names"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "client_id": {"type": "string", "minLength": 1},
        "source_instance": {"type": "string"},
        "window_id": {"type": "string", "minLength": 1},
        "query_type": {"$ref": "#/$defs/query_type"},
        "status": {"type": "string", "enum": ["success", "ocr_failed"]},
        "captured_at": {"type": "string", "format": "date-time"},
        "names": {"type": "array", "items": {"$ref": "#/$defs/ocr_name"}},
        "error_code": {"type": "string"},
        "error_message": {"type": "string"}
      },
      "additionalProperties": true
    },
    "capture_ocr_once": {
      "type": "object",
      "required": ["command", "request_id", "query_type", "expires_at"],
      "properties": {
        "command": {"const": "capture_ocr_once"},
        "request_id": {"type": "string", "minLength": 1},
        "query_type": {"$ref": "#/$defs/query_type"},
        "target_name": {"type": "string"},
        "target_id": {"type": ["integer", "null"], "minimum": 1},
        "window_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "expires_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": true
    },
    "heartbeat_response": {
      "type": "object",
      "required": ["commands"],
      "properties": {
        "commands": {"type": "array", "items": {"$ref": "#/$defs/capture_ocr_once"}}
      },
      "additionalProperties": true
    }
  }
}
