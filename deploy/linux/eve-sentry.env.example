# Intel server listen address
EVE_SENTRY_SERVER_HOST=127.0.0.1
EVE_SENTRY_SERVER_PORT=8765

# Storage
EVE_SENTRY_SERVER_STORAGE=postgres
EVE_SENTRY_SERVER_POSTGRES_DSN=postgresql://eve_sentry:change-me@127.0.0.1:5432/eve_sentry
# Recent reports kept in memory for live alert generation; history stays in PostgreSQL.
EVE_SENTRY_SERVER_HOT_REPORT_LIMIT=5000
EVE_SENTRY_SERVER_DATA=/var/lib/eve-sentry/intel_reports.json
# 0 disables automatic deletion; positive values prune on server startup.
EVE_SENTRY_SERVER_REPORT_RETENTION_DAYS=0
# Inactive transient intel is hidden after restart; prune old rows to bound table size.
EVE_SENTRY_SERVER_INACTIVE_INTEL_RETENTION_DAYS=30
EVE_SENTRY_SERVER_CONFIG=/var/lib/eve-sentry/intel_config.json

# Personnel archive startup default: off / shadow / on (PostgreSQL + ESI required).
# Admin web settings override this default once saved. Mode changes need a restart;
# background refresh/backfill/capacity controls apply to the current scheduler.
EVE_SENTRY_PERSONNEL_CACHE=off

# Authentication. HTTP is supported on trusted networks; HTTPS is recommended publicly.
EVE_SENTRY_SERVER_AUTH_MODE=off
# setup = management/auth enabled while existing data APIs remain open
# enforce = all APIs except health probes and login require authentication
EVE_SENTRY_SERVER_AUTH_BOOTSTRAP_ADMIN=
EVE_SENTRY_SERVER_AUTH_BOOTSTRAP_PASSWORD_FILE=/var/lib/eve-sentry/bootstrap-admin-password
# Optional SeAT key-management integration. Leave empty to keep the interface disabled.
# Use a random secret of at least 32 characters; do not commit the real value.
EVE_SENTRY_SERVER_SEAT_INTEGRATION_TOKEN=
# Seat key authentication: off (default, integration disabled) or enforce.
EVE_SENTRY_SERVER_SEAT_AUTH_MODE=off
# Keep false until Seat pricing, evidence and ledger acceptance are complete.
# Enabling this requires a PostgreSQL store, the Seat integration token and
# EVE_SENTRY_SERVER_SEAT_AUTH_MODE=enforce.
EVE_SENTRY_SERVER_ALLOW_ALERT_CONSUMPTION=0

# Embedded QQ bot.  Keep disabled until the QQ credentials and its database /
# Redis are provisioned on this host.  When enabled, the bot runs in this
# service process and consumes the local durable event stream without a Seat
# client key; do not set the retired EVE_SENTRY_API_KEY.
EVE_SENTRY_SERVER_QQ_BOT_ENABLED=0
EVE_SENTRY_SERVER_QQ_BOT_SOURCE=/opt/eve-sentry/bot/src
EVE_SENTRY_SERVER_QQ_BOT_APP_ID=
EVE_SENTRY_SERVER_QQ_BOT_APP_SECRET=
EVE_SENTRY_SERVER_QQ_BOT_DATABASE_URL=postgresql+asyncpg://eve_risk:change-me@127.0.0.1:5432/eve_risk
EVE_SENTRY_SERVER_QQ_BOT_REDIS_URL=redis://127.0.0.1:6379/0
EVE_SENTRY_SERVER_QQ_BOT_PUBLIC_URL=
EVE_SENTRY_SERVER_QQ_BOT_ALERT_MIN_LEVEL=

# Star map / SDE
EVE_SENTRY_SERVER_MAP_CONFIG=/var/lib/eve-sentry/intel_map.json
EVE_SENTRY_SERVER_MAP_SOURCE=sde
EVE_SENTRY_SERVER_MAP_SDE_PATH=/var/lib/eve-sentry/sde/3417089
EVE_SENTRY_SERVER_MAP_REGION_IDS=10000045
EVE_SENTRY_SERVER_MAP_REFRESH_ON_START=1

# Public ESI enrichment
EVE_SENTRY_SERVER_ENABLE_ESI=0
EVE_SENTRY_SERVER_ESI_CACHE=/var/lib/eve-sentry/esi_cache.json
# Public ESI backend: local or remote. Remote calls the private Gateway on 47.
EVE_SENTRY_SERVER_ESI_BACKEND=local
EVE_SENTRY_SERVER_ESI_GATEWAY_URL=http://10.0.0.1:8787
EVE_SENTRY_SERVER_ESI_GATEWAY_TOKEN=
EVE_SENTRY_SERVER_ESI_REMOTE_TIMEOUT=8
EVE_SENTRY_SERVER_ESI_NO_LOCAL_FALLBACK=0
# Personnel resolution only uses ESI identity/standings; no zKillboard stats requests.

# EVE Online OAuth2 is only used by the server to refresh organization standings.
# Tokens never leave this host; platform authentication remains local/SeAT.
EVE_SENTRY_SERVER_ESI_CLIENT_ID=
EVE_SENTRY_SERVER_ESI_REDIRECT_URI=http://127.0.0.1:8765/api/v1/esi/callback
EVE_SENTRY_SERVER_ESI_TOKEN_FILE=/var/lib/eve-sentry/esi_tokens.json
EVE_SENTRY_SERVER_ESI_TOKEN_STORAGE=plain
EVE_SENTRY_SERVER_ESI_STANDINGS_TTL=600
EVE_SENTRY_SERVER_ESI_SCOPES=esi-characters.read_contacts.v1,esi-characters.read_standings.v1,esi-corporations.read_contacts.v1,esi-alliances.read_contacts.v1
# Run `scripts/run_server.py --esi-login-only` once on a controlled terminal.
