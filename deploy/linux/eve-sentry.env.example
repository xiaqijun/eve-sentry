# Intel server listen address
EVE_SENTRY_SERVER_HOST=127.0.0.1
EVE_SENTRY_SERVER_PORT=8765

# Storage
EVE_SENTRY_SERVER_STORAGE=sqlite
EVE_SENTRY_SERVER_DB=/var/lib/eve-sentry/intel.sqlite3
EVE_SENTRY_SERVER_DATA=/var/lib/eve-sentry/intel_reports.json
EVE_SENTRY_SERVER_CONFIG=/var/lib/eve-sentry/intel_config.json

# Star map / SDE
EVE_SENTRY_SERVER_MAP_CONFIG=/var/lib/eve-sentry/intel_map.json
EVE_SENTRY_SERVER_MAP_SOURCE=sde
EVE_SENTRY_SERVER_MAP_SDE_PATH=/var/lib/eve-sentry/sde/3417089
EVE_SENTRY_SERVER_MAP_REGION_IDS=10000045
EVE_SENTRY_SERVER_MAP_REFRESH_ON_START=1

# Public ESI enrichment
EVE_SENTRY_SERVER_ENABLE_ESI=0
EVE_SENTRY_SERVER_ESI_CACHE=/var/lib/eve-sentry/esi_cache.json

# Authenticated ESI session
EVE_SENTRY_SERVER_ESI_CLIENT_ID=
EVE_SENTRY_SERVER_ESI_REDIRECT_URI=http://127.0.0.1:8766/callback
EVE_SENTRY_SERVER_ESI_TOKEN_FILE=/var/lib/eve-sentry/esi_tokens.json
EVE_SENTRY_SERVER_ESI_TOKEN_STORAGE=plain
EVE_SENTRY_SERVER_ESI_SCOPES=esi-location.read_location.v1,esi-characters.read_contacts.v1
