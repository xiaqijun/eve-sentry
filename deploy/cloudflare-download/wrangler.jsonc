{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eve-sentry-download",
  "main": "src/index.js",
  "compatibility_date": "2026-07-28",
  "workers_dev": true,
  "assets": {
    "directory": "../../download-site/out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/health",
      "/latest.json",
      "/download/*"
    ]
  },
  "routes": [
    {
      "pattern": "evesentrydownload.kisectool.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "GITHUB_OWNER": "xiaqijun",
    "GITHUB_REPO": "eve-sentry"
  }
}
